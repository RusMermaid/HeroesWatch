<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- Repository language-display metadata is never compiled or published. -->
    <Compile Remove="RepositoryMetadata/**" />
    <Content Remove="RepositoryMetadata/**" />
    <None Remove="RepositoryMetadata/**" />
  </ItemGroup>

</Project>
